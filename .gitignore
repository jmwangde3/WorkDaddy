# macOS
.DS_Store

# Node
node_modules/
npm-debug.log*

# 构建产物与安装包
WorkDaddy.app
/release/**/*.dmg
/release/**/*.exe
/release/**/*.zip
/release/**/*.pkg
/release/**/*.tar.gz
/release/**/*.deb

# 本地运行数据与日志
*.log
daemon.log

# 内部调试模块（元素检查/DevTools 实现，不公开入库；他人环境点按钮报错属预期）
scripts/picker-internal.js

# 工作区元数据（WorkBuddy 项目数据，不入库）
.workbuddy/
.workbuddy-ai/

# 本地维护文档与排查记录
/.private-docs/

# 构建缓存(安装器临时产物)
release/.cache/

# 测试用临时安装目录（test/installer-lifecycle.test.js 在这里造夹具）
/tmp/

# Python 缓存
__pycache__/
*.pyc

# 本机 WorkBuddy 客户端路径（部署时生成，不入库）
scripts/workbuddy-exe.json

# 测试跑测产物（每次都变，不入库）
test/last-run.tap

# 打包输出（installer/build-package.ps1 默认写到这里；SHA256SUMS.txt 不在上面的通配里）
/release/dist/
